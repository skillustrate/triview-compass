  "findings": [
    {
      "id": "finding-1",
      "category": "performance",
      "severity": "Optional",
      "title": "Two git subprocesses spawned per changed file (size then blob)",
      "impact": "For each changed file the loop runs `git cat-file -s` and then `git cat-file blob`, so process spawns grow as 2N, up to maxFiles. Each spawn costs process startup plus env copying. This lengthens capture latency and risks CAPTURE_TIMEOUT on large changes. The blob is fully buffered (up to 16MB maxBuffer) after a separate size check.",
      "evidence": {
        "path": "triview-compass/src/core/git-capture.js",
        "startLine": 139,
        "endLine": 150
      },
      "recommendation": "Use a single long-lived `git cat-file --batch` process, or `--batch-check` for sizes and `--batch` for contents, to read all blobs in one process. The size check is then done from the batch header before reading content. Measure with a change near maxFiles to confirm.",
      "sourceFindings": [
        {
          "reviewer": "performance",
          "findingId": "perf-1",
          "severity": "Optional",
          "confidence": 0.5
        }
      ],
      "disagreement": false
    }
  ],
