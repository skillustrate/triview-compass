{
  "contractVersion": "1.0",
  "mode": "full",
  "reviewers": [
    "code-quality",
    "security",
    "performance"
  ],
  "budgets": {
    "maxFiles": 50,
    "maxChangedLines": 6000,
    "maxLinesPerFile": 2000,
    "maxBytesPerFile": 1048576,
    "maxInputTokensPerReviewer": 150000,
    "maxOutputTokensPerReviewer": 2000,
    "maxModelCalls": 3,
    "timeoutSeconds": 120
  },
  "dataPolicy": {
    "mode": "approved-hosted",
    "selectedProvider": "anthropic-claude-code",
    "allowedProviders": [
      "anthropic-claude-code"
    ]
  },
  "pathPolicy": {
    "excludedPathGlobs": [
      ".gitattributes",
      ".gitignore",
      ".gitmodules",
      ".mailmap",
      ".travis.yml",
      "BENTO_BUILD.txt",
      "COMPATIBILITY",
      "DEV_README.txt",
      "INSTALL.txt",
      "LICENSE.txt",
      "MANIFEST.in",
      "README.txt",
      "TEST_COMMIT",
      "THANKS.txt",
      "bento.info",
      "branding/**",
      "bscript",
      "doc/**",
      "numpy/__config__.py.in",
      "numpy/__init__.py",
      "numpy/_import_tools.py",
      "numpy/add_newdocs.py",
      "numpy/bento.info",
      "numpy/build_utils/**",
      "numpy/compat/**",
      "numpy/core/**",
      "numpy/ctypeslib.py",
      "numpy/distutils/**",
      "numpy/doc/**",
      "numpy/dual.py",
      "numpy/f2py/__version__.py",
      "numpy/f2py/auxfuncs.py",
      "numpy/f2py/capi_maps.py",
      "numpy/f2py/cb_rules.py",
      "numpy/f2py/cfuncs.py",
      "numpy/f2py/common_rules.py",
      "numpy/f2py/crackfortran.py",
      "numpy/f2py/diagnose.py",
      "numpy/f2py/f2py_testing.py",
      "numpy/f2py/f90mod_rules.py",
      "numpy/f2py/func2subr.py",
      "numpy/f2py/info.py",
      "numpy/f2py/rules.py",
      "numpy/f2py/setup.cfg",
      "numpy/f2py/setup.py",
      "numpy/f2py/src/**",
      "numpy/f2py/tests/**",
      "numpy/f2py/use_rules.py",
      "numpy/fft/**",
      "numpy/lib/**",
      "numpy/linalg/**",
      "numpy/ma/**",
      "numpy/matlib.py",
      "numpy/matrixlib/**",
      "numpy/polynomial/**",
      "numpy/random/**",
      "numpy/setup.py",
      "numpy/testing/**",
      "numpy/tests/**",
      "numpy/version.py.in",
      "pavement.py",
      "release.sh",
      "runtests.py",
      "setup.py",
      "setupegg.py",
      "site.cfg.example",
      "tools/**",
      "tox.ini"
    ],
    "generatedPathGlobs": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ],
    "symlinkHandling": "reject",
    "binaryHandling": "report-and-skip"
  },
  "secretPolicy": {
    "scannerRequired": true,
    "sensitivePathGlobs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/.aws/**",
      "**/.ssh/**",
      "**/.config/gcloud/**",
      "**/credentials",
      "**/credentials.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx"
    ],
    "onScannerFailure": "stop-review"
  },
  "sandbox": {
    "executionRequested": false,
    "backend": "none",
    "network": "disabled"
  }
}
