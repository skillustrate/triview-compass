{
  "contractVersion": "1.0",
  "mode": "full",
  "reviewers": [
    "code-quality",
    "security",
    "performance"
  ],
  "budgets": {
    "maxFiles": 50,
    "maxChangedLines": 6000,
    "maxLinesPerFile": 2000,
    "maxBytesPerFile": 1048576,
    "maxInputTokensPerReviewer": 100000,
    "maxOutputTokensPerReviewer": 2000,
    "maxModelCalls": 3,
    "timeoutSeconds": 120
  },
  "dataPolicy": {
    "mode": "approved-hosted",
    "selectedProvider": "anthropic-claude-code",
    "allowedProviders": [
      "anthropic-claude-code"
    ]
  },
  "pathPolicy": {
    "excludedPathGlobs": [
      "triview-compass/.gitattributes",
      "triview-compass/.gitignore",
      "triview-compass/LICENSE",
      "triview-compass/README.md",
      "triview-compass/SECURITY.md",
      "triview-compass/STATE.md",
      "triview-compass/adapters/**",
      "triview-compass/agents/**",
      "triview-compass/contracts/**",
      "triview-compass/design.md",
      "triview-compass/evals/**",
      "triview-compass/examples/**",
      "triview-compass/package-lock.json",
      "triview-compass/package.json",
      "triview-compass/plan.md",
      "triview-compass/skills/**",
      "triview-compass/src/README.md",
      "triview-compass/src/adapters/harness/**",
      "triview-compass/src/adapters/model/README.md",
      "triview-compass/src/adapters/model/lm-studio.js",
      "triview-compass/src/adapters/sandbox/**",
      "triview-compass/src/cli/**",
      "triview-compass/src/core/**",
      "triview-compass/tests/**"
    ],
    "generatedPathGlobs": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ],
    "symlinkHandling": "reject",
    "binaryHandling": "report-and-skip"
  },
  "secretPolicy": {
    "scannerRequired": true,
    "sensitivePathGlobs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/.aws/**",
      "**/.ssh/**",
      "**/.config/gcloud/**",
      "**/credentials",
      "**/credentials.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx"
    ],
    "onScannerFailure": "stop-review"
  },
  "sandbox": {
    "executionRequested": false,
    "backend": "none",
    "network": "disabled"
  }
}
