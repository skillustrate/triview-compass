{
  "contractVersion": "1.0",
  "mode": "full",
  "reviewers": [
    "code-quality",
    "security",
    "performance"
  ],
  "budgets": {
    "maxFiles": 50,
    "maxChangedLines": 6000,
    "maxLinesPerFile": 2000,
    "maxBytesPerFile": 1048576,
    "maxInputTokensPerReviewer": 100000,
    "maxOutputTokensPerReviewer": 2000,
    "maxModelCalls": 3,
    "timeoutSeconds": 120
  },
  "dataPolicy": {
    "mode": "approved-hosted",
    "selectedProvider": "anthropic-claude-code",
    "allowedProviders": [
      "anthropic-claude-code"
    ]
  },
  "pathPolicy": {
    "excludedPathGlobs": [
      ".bazelrc",
      ".generated_files",
      ".gitattributes",
      ".github/**",
      ".gitignore",
      ".kazelcfg.json",
      "BUILD.bazel",
      "CHANGELOG-1.10.md",
      "CHANGELOG-1.11.md",
      "CHANGELOG-1.12.md",
      "CHANGELOG-1.13.md",
      "CHANGELOG-1.14.md",
      "CHANGELOG-1.15.md",
      "CHANGELOG-1.16.md",
      "CHANGELOG-1.2.md",
      "CHANGELOG-1.3.md",
      "CHANGELOG-1.4.md",
      "CHANGELOG-1.5.md",
      "CHANGELOG-1.6.md",
      "CHANGELOG-1.7.md",
      "CHANGELOG-1.8.md",
      "CHANGELOG-1.9.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "Godeps/**",
      "LICENSE",
      "Makefile",
      "Makefile.generated_files",
      "OWNERS",
      "OWNERS_ALIASES",
      "README.md",
      "SECURITY_CONTACTS",
      "SUPPORT.md",
      "WORKSPACE",
      "api/**",
      "build/**",
      "cluster/**",
      "cmd/**",
      "code-of-conduct.md",
      "docs/**",
      "go.mod",
      "go.sum",
      "hack/**",
      "logo/**",
      "pkg/.import-restrictions",
      "pkg/BUILD",
      "pkg/OWNERS",
      "pkg/api/**",
      "pkg/apis/**",
      "pkg/auth/**",
      "pkg/capabilities/**",
      "pkg/client/**",
      "pkg/cloudprovider/**",
      "pkg/controller/**",
      "pkg/credentialprovider/BUILD",
      "pkg/credentialprovider/OWNERS",
      "pkg/credentialprovider/aws/**",
      "pkg/credentialprovider/azure/**",
      "pkg/credentialprovider/config_test.go",
      "pkg/credentialprovider/doc.go",
      "pkg/credentialprovider/gcp/**",
      "pkg/credentialprovider/keyring.go",
      "pkg/credentialprovider/keyring_test.go",
      "pkg/credentialprovider/plugins.go",
      "pkg/credentialprovider/provider.go",
      "pkg/credentialprovider/provider_test.go",
      "pkg/credentialprovider/secrets/**",
      "pkg/features/**",
      "pkg/fieldpath/**",
      "pkg/generated/**",
      "pkg/kubeapiserver/**",
      "pkg/kubectl/**",
      "pkg/kubelet/**",
      "pkg/kubemark/**",
      "pkg/master/**",
      "pkg/printers/**",
      "pkg/probe/**",
      "pkg/proxy/**",
      "pkg/quota/**",
      "pkg/registry/**",
      "pkg/routes/**",
      "pkg/scheduler/**",
      "pkg/security/**",
      "pkg/securitycontext/**",
      "pkg/serviceaccount/**",
      "pkg/ssh/**",
      "pkg/util/**",
      "pkg/version/**",
      "pkg/volume/**",
      "pkg/watch/**",
      "pkg/windows/**",
      "plugin/**",
      "staging/**",
      "test/**",
      "third_party/**",
      "translations/**",
      "vendor/**"
    ],
    "generatedPathGlobs": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ],
    "symlinkHandling": "reject",
    "binaryHandling": "report-and-skip"
  },
  "secretPolicy": {
    "scannerRequired": true,
    "sensitivePathGlobs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/.aws/**",
      "**/.ssh/**",
      "**/.config/gcloud/**",
      "**/credentials",
      "**/credentials.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx"
    ],
    "onScannerFailure": "stop-review"
  },
  "sandbox": {
    "executionRequested": false,
    "backend": "none",
    "network": "disabled"
  }
}
