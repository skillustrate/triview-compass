{
  "contractVersion": "1.0",
  "mode": "full",
  "reviewers": [
    "code-quality",
    "security",
    "performance"
  ],
  "budgets": {
    "maxFiles": 50,
    "maxChangedLines": 6000,
    "maxLinesPerFile": 2000,
    "maxBytesPerFile": 1048576,
    "maxInputTokensPerReviewer": 100000,
    "maxOutputTokensPerReviewer": 2000,
    "maxModelCalls": 3,
    "timeoutSeconds": 120
  },
  "dataPolicy": {
    "mode": "approved-hosted",
    "selectedProvider": "anthropic-claude-code",
    "allowedProviders": [
      "anthropic-claude-code"
    ]
  },
  "pathPolicy": {
    "excludedPathGlobs": [
      ".bazelrc",
      ".generated_files",
      ".gitattributes",
      ".github/**",
      ".gitignore",
      ".kazelcfg.json",
      "BUILD.bazel",
      "CHANGELOG-1.15.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "Godeps/**",
      "LICENSE",
      "Makefile",
      "Makefile.generated_files",
      "OWNERS",
      "OWNERS_ALIASES",
      "README.md",
      "SECURITY_CONTACTS",
      "SUPPORT.md",
      "WORKSPACE",
      "api/**",
      "build/**",
      "cluster/**",
      "cmd/**",
      "code-of-conduct.md",
      "docs/**",
      "go.mod",
      "go.sum",
      "hack/**",
      "logo/**",
      "pkg/.import-restrictions",
      "pkg/BUILD",
      "pkg/OWNERS",
      "pkg/api/**",
      "pkg/apis/**",
      "pkg/auth/**",
      "pkg/capabilities/**",
      "pkg/client/**",
      "pkg/cloudprovider/**",
      "pkg/controller/**",
      "pkg/credentialprovider/**",
      "pkg/features/**",
      "pkg/fieldpath/**",
      "pkg/generated/**",
      "pkg/kubeapiserver/**",
      "pkg/kubectl/.import-restrictions",
      "pkg/kubectl/BUILD",
      "pkg/kubectl/OWNERS",
      "pkg/kubectl/apply.go",
      "pkg/kubectl/apply/**",
      "pkg/kubectl/apps/**",
      "pkg/kubectl/cmd/BUILD",
      "pkg/kubectl/cmd/alpha.go",
      "pkg/kubectl/cmd/annotate/**",
      "pkg/kubectl/cmd/apiresources/**",
      "pkg/kubectl/cmd/apply/**",
      "pkg/kubectl/cmd/attach/**",
      "pkg/kubectl/cmd/auth/**",
      "pkg/kubectl/cmd/autoscale/**",
      "pkg/kubectl/cmd/certificates/**",
      "pkg/kubectl/cmd/clusterinfo/**",
      "pkg/kubectl/cmd/cmd.go",
      "pkg/kubectl/cmd/cmd_test.go",
      "pkg/kubectl/cmd/completion/**",
      "pkg/kubectl/cmd/config/**",
      "pkg/kubectl/cmd/convert/**",
      "pkg/kubectl/cmd/cp/BUILD",
      "pkg/kubectl/cmd/cp/cp_test.go",
      "pkg/kubectl/cmd/create/**",
      "pkg/kubectl/cmd/delete/**",
      "pkg/kubectl/cmd/describe/**",
      "pkg/kubectl/cmd/diff/**",
      "pkg/kubectl/cmd/drain/**",
      "pkg/kubectl/cmd/edit/**",
      "pkg/kubectl/cmd/exec/**",
      "pkg/kubectl/cmd/explain/**",
      "pkg/kubectl/cmd/expose/**",
      "pkg/kubectl/cmd/get/**",
      "pkg/kubectl/cmd/help/**",
      "pkg/kubectl/cmd/kustomize/**",
      "pkg/kubectl/cmd/label/**",
      "pkg/kubectl/cmd/logs/**",
      "pkg/kubectl/cmd/options/**",
      "pkg/kubectl/cmd/patch/**",
      "pkg/kubectl/cmd/plugin/**",
      "pkg/kubectl/cmd/portforward/**",
      "pkg/kubectl/cmd/profiling.go",
      "pkg/kubectl/cmd/proxy/**",
      "pkg/kubectl/cmd/replace/**",
      "pkg/kubectl/cmd/rollingupdate/**",
      "pkg/kubectl/cmd/rollout/**",
      "pkg/kubectl/cmd/run/**",
      "pkg/kubectl/cmd/scale/**",
      "pkg/kubectl/cmd/set/**",
      "pkg/kubectl/cmd/taint/**",
      "pkg/kubectl/cmd/testing/**",
      "pkg/kubectl/cmd/top/**",
      "pkg/kubectl/cmd/util/**",
      "pkg/kubectl/cmd/version/**",
      "pkg/kubectl/cmd/wait/**",
      "pkg/kubectl/conditions.go",
      "pkg/kubectl/describe/**",
      "pkg/kubectl/doc.go",
      "pkg/kubectl/drain/**",
      "pkg/kubectl/explain/**",
      "pkg/kubectl/generate/**",
      "pkg/kubectl/generated/**",
      "pkg/kubectl/history.go",
      "pkg/kubectl/history_test.go",
      "pkg/kubectl/interfaces.go",
      "pkg/kubectl/metricsutil/**",
      "pkg/kubectl/polymorphichelpers/**",
      "pkg/kubectl/proxy/**",
      "pkg/kubectl/rollback.go",
      "pkg/kubectl/rollback_test.go",
      "pkg/kubectl/rolling_updater.go",
      "pkg/kubectl/rolling_updater_test.go",
      "pkg/kubectl/rollout_status.go",
      "pkg/kubectl/rollout_status_test.go",
      "pkg/kubectl/scale.go",
      "pkg/kubectl/scale_test.go",
      "pkg/kubectl/scheme/**",
      "pkg/kubectl/util/**",
      "pkg/kubectl/validation/**",
      "pkg/kubectl/version/**",
      "pkg/kubelet/**",
      "pkg/kubemark/**",
      "pkg/master/**",
      "pkg/printers/**",
      "pkg/probe/**",
      "pkg/proxy/**",
      "pkg/quota/**",
      "pkg/registry/**",
      "pkg/routes/**",
      "pkg/scheduler/**",
      "pkg/security/**",
      "pkg/securitycontext/**",
      "pkg/serviceaccount/**",
      "pkg/ssh/**",
      "pkg/util/**",
      "pkg/version/**",
      "pkg/volume/**",
      "pkg/watch/**",
      "pkg/windows/**",
      "plugin/**",
      "staging/**",
      "test/**",
      "third_party/**",
      "translations/**",
      "vendor/**"
    ],
    "generatedPathGlobs": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ],
    "symlinkHandling": "reject",
    "binaryHandling": "report-and-skip"
  },
  "secretPolicy": {
    "scannerRequired": true,
    "sensitivePathGlobs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/.aws/**",
      "**/.ssh/**",
      "**/.config/gcloud/**",
      "**/credentials",
      "**/credentials.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx"
    ],
    "onScannerFailure": "stop-review"
  },
  "sandbox": {
    "executionRequested": false,
    "backend": "none",
    "network": "disabled"
  }
}
