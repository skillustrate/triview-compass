{
  "contractVersion": "1.0",
  "mode": "full",
  "reviewers": [
    "code-quality",
    "security",
    "performance"
  ],
  "budgets": {
    "maxFiles": 50,
    "maxChangedLines": 6000,
    "maxLinesPerFile": 2000,
    "maxBytesPerFile": 1048576,
    "maxInputTokensPerReviewer": 230000,
    "maxOutputTokensPerReviewer": 2000,
    "maxModelCalls": 3,
    "timeoutSeconds": 240
  },
  "dataPolicy": {
    "mode": "approved-hosted",
    "selectedProvider": "anthropic-claude-code",
    "allowedProviders": [
      "anthropic-claude-code"
    ]
  },
  "pathPolicy": {
    "excludedPathGlobs": [
      ".appveyor.yml",
      ".gitattributes",
      ".gitignore",
      "Build/**",
      "CONTRIBUTING.md",
      "Doc/**",
      "ISSUE_TEMPLATE.md",
      "LICENSE.md",
      "README.md",
      "Src/Directory.Build.props",
      "Src/Newtonsoft.Json.TestConsole/**",
      "Src/Newtonsoft.Json.Tests/**",
      "Src/Newtonsoft.Json.sln",
      "Src/Newtonsoft.Json.sln.DotSettings",
      "Src/Newtonsoft.Json/Bson/**",
      "Src/Newtonsoft.Json/ConstructorHandling.cs",
      "Src/Newtonsoft.Json/Converters/**",
      "Src/Newtonsoft.Json/DateFormatHandling.cs",
      "Src/Newtonsoft.Json/DateParseHandling.cs",
      "Src/Newtonsoft.Json/DateTimeZoneHandling.cs",
      "Src/Newtonsoft.Json/DefaultJsonNameTable.cs",
      "Src/Newtonsoft.Json/DefaultValueHandling.cs",
      "Src/Newtonsoft.Json/Dynamic.snk",
      "Src/Newtonsoft.Json/FloatFormatHandling.cs",
      "Src/Newtonsoft.Json/FloatParseHandling.cs",
      "Src/Newtonsoft.Json/FormatterAssemblyStyle.cs",
      "Src/Newtonsoft.Json/Formatting.cs",
      "Src/Newtonsoft.Json/IArrayPool.cs",
      "Src/Newtonsoft.Json/IJsonLineInfo.cs",
      "Src/Newtonsoft.Json/JsonArrayAttribute.cs",
      "Src/Newtonsoft.Json/JsonConstructorAttribute.cs",
      "Src/Newtonsoft.Json/JsonContainerAttribute.cs",
      "Src/Newtonsoft.Json/JsonConvert.cs",
      "Src/Newtonsoft.Json/JsonConverter.cs",
      "Src/Newtonsoft.Json/JsonConverterAttribute.cs",
      "Src/Newtonsoft.Json/JsonConverterCollection.cs",
      "Src/Newtonsoft.Json/JsonDictionaryAttribute.cs",
      "Src/Newtonsoft.Json/JsonException.cs",
      "Src/Newtonsoft.Json/JsonExtensionDataAttribute.cs",
      "Src/Newtonsoft.Json/JsonIgnoreAttribute.cs",
      "Src/Newtonsoft.Json/JsonNameTable.cs",
      "Src/Newtonsoft.Json/JsonObjectAttribute.cs",
      "Src/Newtonsoft.Json/JsonPosition.cs",
      "Src/Newtonsoft.Json/JsonPropertyAttribute.cs",
      "Src/Newtonsoft.Json/JsonReader.Async.cs",
      "Src/Newtonsoft.Json/JsonReaderException.cs",
      "Src/Newtonsoft.Json/JsonRequiredAttribute.cs",
      "Src/Newtonsoft.Json/JsonSerializationException.cs",
      "Src/Newtonsoft.Json/JsonTextReader.Async.cs",
      "Src/Newtonsoft.Json/JsonTextReader.cs",
      "Src/Newtonsoft.Json/JsonTextWriter.Async.cs",
      "Src/Newtonsoft.Json/JsonTextWriter.cs",
      "Src/Newtonsoft.Json/JsonToken.cs",
      "Src/Newtonsoft.Json/JsonValidatingReader.cs",
      "Src/Newtonsoft.Json/JsonWriter.Async.cs",
      "Src/Newtonsoft.Json/JsonWriter.cs",
      "Src/Newtonsoft.Json/JsonWriterException.cs",
      "Src/Newtonsoft.Json/Linq/**",
      "Src/Newtonsoft.Json/MemberSerialization.cs",
      "Src/Newtonsoft.Json/MetadataPropertyHandling.cs",
      "Src/Newtonsoft.Json/MissingMemberHandling.cs",
      "Src/Newtonsoft.Json/Newtonsoft.Json.csproj",
      "Src/Newtonsoft.Json/Newtonsoft.Json.ruleset",
      "Src/Newtonsoft.Json/NullValueHandling.cs",
      "Src/Newtonsoft.Json/ObjectCreationHandling.cs",
      "Src/Newtonsoft.Json/PreserveReferencesHandling.cs",
      "Src/Newtonsoft.Json/Properties/**",
      "Src/Newtonsoft.Json/ReferenceLoopHandling.cs",
      "Src/Newtonsoft.Json/Required.cs",
      "Src/Newtonsoft.Json/Schema/**",
      "Src/Newtonsoft.Json/Serialization/**",
      "Src/Newtonsoft.Json/SerializationBinder.cs",
      "Src/Newtonsoft.Json/StringEscapeHandling.cs",
      "Src/Newtonsoft.Json/TraceLevel.cs",
      "Src/Newtonsoft.Json/TypeNameAssemblyFormatHandling.cs",
      "Src/Newtonsoft.Json/TypeNameHandling.cs",
      "Src/Newtonsoft.Json/Utilities/**",
      "Src/Newtonsoft.Json/WriteState.cs",
      "Src/Newtonsoft.Json/packageIcon.png",
      "Src/NuGet.Config",
      "Src/global.json",
      "azure-pipelines.yml"
    ],
    "generatedPathGlobs": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/coverage/**"
    ],
    "symlinkHandling": "reject",
    "binaryHandling": "report-and-skip"
  },
  "secretPolicy": {
    "scannerRequired": true,
    "sensitivePathGlobs": [
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/.aws/**",
      "**/.ssh/**",
      "**/.config/gcloud/**",
      "**/credentials",
      "**/credentials.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx"
    ],
    "onScannerFailure": "stop-review"
  },
  "sandbox": {
    "executionRequested": false,
    "backend": "none",
    "network": "disabled"
  }
}
